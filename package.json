{
  "name": "tradingkitchen",
  "version": "1.0.0",
  "private": true,
  "description": "The Trading Kitchen static recipe website",
  "scripts": {
    "test": "node --test tests/*.test.cjs && npm run build",
    "build:css": "tailwindcss --config scripts/tailwind.config.cjs --input scripts/tailwind.css --output assets/tailwind.css --minify",
    "build": "npm run build:css && python3 scripts/build.py && npm run validate",
    "validate": "python3 scripts/validate.py _site",
    "preview": "python3 -m http.server 8000 --directory _site"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  }
}
